# Copy to .env for local work. On EasyPanel set these as environment variables
# instead — .env is gitignored and is not in the image.
#
# Only ANTHROPIC_API_KEY is required. Everything below has a working default,
# and the app serves the corpus, the shipped demo runs and the policy library
# without a key at all.

# ---------------------------------------------------------------- required
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- serving
# Injected by EasyPanel; the entrypoint falls back to 8000.
# PORT=8000

# Where the index, uploads and runs live. Point this at a mounted volume to keep
# runs across redeploys. Everything else derives from it, so this is the only
# storage setting.
# DATA_DIR=/app/data

# Browsers that may call the API cross-origin. Irrelevant for the single-
# container deploy, where the UI is served from the same origin.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- models
# Opus makes the judgement the analyst is accountable for; Sonnet does the
# high-fan-out expansion and obligation extraction.
# MODEL_REASONING=claude-opus-5
# MODEL_FAST=claude-sonnet-5

# Parallel model calls. A 64-question form is ~190 calls; raise for speed,
# lower if you hit rate limits.
# LLM_MAX_CONCURRENCY=10

# ---------------------------------------------------------------- evidence
# "documents" sends whole shortlisted policies to the reasoning model.
# "passages" sends only the top-ranked chunks — markedly cheaper, at the cost of
# silently missing a policy that lexical search ranked poorly.
#
# Cost note: a full 64-question run in "documents" mode is the most expensive
# thing this app does. If the deployment is public, either switch to "passages"
# or leave the question cap in the launcher low.
# EVIDENCE_MODE=documents
# DOC_CONTEXT_MAX=8
# DOC_CONTEXT_TOKEN_BUDGET=150000
# DOC_CONTEXT_MAX_SHARE=0.35

# ---------------------------------------------------------------- retrieval
# DOC_CANDIDATES=10
# CHUNK_CANDIDATES=30
# VERIFY_PASSAGES=10
